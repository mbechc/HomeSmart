    {
        "id": "bc52ff632055fe42",
        "type": "timed-counter",
        "z": "02da2d1e7cb0521c",
        "name": "detectDouble",
        "timelimit": "400",
        "timeunit": 1,
        "withhold": true,
        "fixedtimeout": true,
        "pertopic": true,
        "countlimit": "",
        "x": 420,
        "y": 260,
        "wires": [
            [
                "bfecf3eff81bc3a5"
            ]
        ]
    },
    {
        "id": "bfecf3eff81bc3a5",
        "type": "function",
        "z": "02da2d1e7cb0521c",
        "name": "Single or Doubleclick",
        "func": "if (msg.count==4) {\n    flow.set(\"dimmerMode\", 1)\n    msg = null;\n    }\n// Double press detected, entering dimmerMode\n\nelse if (msg.payload.action == \"release_1\") {msg.payload = 255}\n// On button pressed once\nelse if (msg.payload.action == \"release_2\") { msg.payload = -255 }\n// Off button pressed once\nelse if (msg.payload.action == \"release_3\") { msg.payload = 255 }\n// On button pressed once\nelse if (msg.payload.action == \"release_4\") { msg.payload = -255 }\n// Off button pressed once\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 260,
        "wires": [
            [
                "60dca15f4c6aa50a"
            ]
        ]
    },
    {
        "id": "480714a77d5f7137",
        "type": "switch",
        "z": "02da2d1e7cb0521c",
        "name": "dimmerMode",
        "property": "dimmerMode",
        "propertyType": "flow",
        "rules": [
            {
                "t": "eq",
                "v": "1",
                "vt": "num"
            },
            {
                "t": "else"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 2,
        "x": 200,
        "y": 180,
        "wires": [
            [
                "6f298514e6451b82"
            ],
            [
                "bc52ff632055fe42"
            ]
        ]
    },
    {
        "id": "60dca15f4c6aa50a",
        "type": "trigger",
        "z": "02da2d1e7cb0521c",
        "name": "exit dimmerMode in 3 sec",
        "op1": "",
        "op2": "",
        "op1type": "nul",
        "op2type": "date",
        "duration": "3",
        "extend": true,
        "overrideDelay": false,
        "units": "s",
        "reset": "",
        "bytopic": "all",
        "topic": "topic",
        "outputs": 1,
        "x": 950,
        "y": 220,
        "wires": [
            [
                "cb78e8b205229939"
            ]
        ]
    },
    {
        "id": "cb78e8b205229939",
        "type": "function",
        "z": "02da2d1e7cb0521c",
        "name": "dimmerMode=0",
        "func": "flow.set(\"dimmerMode\", 0)\nmsg.reset=true\nreturn msg",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1200,
        "y": 220,
        "wires": [
            []
        ]
    },
    {
        "id": "6f298514e6451b82",
        "type": "function",
        "z": "02da2d1e7cb0521c",
        "name": "normalizeDim",
        "func": "if (msg.payload.action.includes(\"release\")) { msg.payload = \"stop\" }\n\nelse if (msg.payload.action == \"press_1\") {msg.payload = \"up\"}\n\nelse if (msg.payload.action == \"press_2\") {msg.payload = \"down\"}\n\nelse if (msg.payload.action == \"press_3\") {msg.payload = \"up\"}\n\nelse if (msg.payload.action == \"press_4\") {msg.payload = \"down\"}\n\nreturn msg;\n\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 100,
        "wires": [
            [
                "9a0935e46d1c932c"
            ]
        ]
    },
