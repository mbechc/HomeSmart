    {
        "id": "01352fde99019142",
        "type": "function",
        "z": "07d8eff2566f48c0",
        "name": "function 5",
        "func": "if (msg.payload.action == \"press_1\" )\n{ \n    msg.payload.button  = \"up\"\n    msg.payload.side    = \"left\" \n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 40,
        "wires": [
            []
        ]
    },
    {
        "id": "7e9ab0a1a92e32e2",
        "type": "function",
        "z": "07d8eff2566f48c0",
        "name": "function 6",
        "func": "if (msg.payload.action.includes(\"press\")) { msg.payload = 1 }\nif (msg.payload.action.includes(\"release\")) { msg.payload = 0 }\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
